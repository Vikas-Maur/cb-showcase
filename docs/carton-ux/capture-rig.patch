+.cap-tl-clip[data-kind=Mine]{background:linear-gradient(90deg,#a00,#aa0,#0a0,#00a,#a0a)}
+/* the agent's chat column */
+.cap-chat{flex:none;width:380px;display:flex;flex-direction:column;background:#0f0f0f;border-left:1px solid #ffffff0a}
+.cap-chat-head{display:flex;align-items:center;height:48px;padding:0 14px}
