+.cap-chat-empty{flex:1;display:flex;align-items:center;justify-content:center;padding:0 60px;text-align:center;color:#a3a3a3;font-size:14px}
+.cap-composer{display:flex;flex-direction:column;height:130px;margin:14px;padding:14px 18px;border-radius:12px;background:#151515;box-shadow:inset 0 0 0 1px #ffffff14}
