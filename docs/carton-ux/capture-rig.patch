+/* the stage: Cardboard's preview column, the video letterboxed */
+.cap-stage{flex:1;min-width:0;display:flex;align-items:center;justify-content:center;overflow:hidden}
+.cap-video{position:relative;width:86%;max-height:62%;aspect-ratio:16/9;background:linear-gradient(90deg,#f21 0 16.6%,#0d0 0 33.3%,#ee0 0 50%,#00e 0 66.6%,#f2f 0 83.3%,#0ef 0);box-shadow:0 0 0 1px #0006}
