# Cardboard's app, downloads and unpacked code: large, and not ours to redistribute.
/Cardboard-win/
/dl/
/extracted/
/asar-src/
/main.orig.js
/library-worker.orig.js
/cardboard.orig.mjs
/cli-media.orig.mjs
/tabs.orig.js
/index.orig.js
/EditorRoute.orig.js
/installErrorTelemetry.orig.js

# What scripts/build-windows.js builds (--baseline into out-baseline).
/out/
/out-baseline/

# Benchmark clips (scripts/bench/media.js) and results (scripts/bench/run.js).
/bench-media/
/bench-results/

# Build tools (reinstall with `pnpm install --frozen-lockfile` in tools/).
/tools/*
!/tools/package.json
!/tools/pnpm-lock.yaml

# Screenshots taken by scripts/shot.ps1.
/shot.png

# Local inspection copies of Cardboard internals: proprietary, never commit.
_inspect/
