{
  "name": "carton",
  "private": true,
  "description": "Carton: git for video, plus live collaboration, for Cardboard. pnpm workspace root (pnpm-workspace.yaml lists the packages).",
  "type": "module",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "test": "pnpm -r --no-sort --workspace-concurrency=1 --no-bail --if-present run test",
    "typecheck": "pnpm -r --no-sort --workspace-concurrency=1 --no-bail --if-present run typecheck",
    "build": "node scripts/build.mjs",
    "size": "node scripts/size.mjs",
    "deploy:cloudflare": "node packages/server-cloudflare/build-site.mjs && wrangler deploy -c packages/server-cloudflare/wrangler.production.toml",
    "deploy:cloudflare:web": "node apps/web/build.mjs --out packages/server-cloudflare/dist/site && wrangler deploy -c packages/server-cloudflare/wrangler.production.toml"
  },
  "devDependencies": {
    "@carton/blob-fs": "workspace:*",
    "@carton/blob-memory": "workspace:*",
    "@carton/cardboard": "workspace:*",
    "@carton/cli-mcp": "workspace:*",
    "@carton/comments": "workspace:*",
    "@carton/conformance": "workspace:*",
    "@carton/core": "workspace:*",
    "@carton/host-http": "workspace:*",
    "@carton/http-node": "workspace:*",
    "@carton/local": "workspace:*",
    "@carton/media": "workspace:*",
    "@carton/react": "workspace:*",
    "@carton/server": "workspace:*",
    "@carton/server-node": "workspace:*",
    "@carton/store-memory": "workspace:*",
    "@carton/store-sqlite": "workspace:*",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "4.156.0"
  }
}
