{
  "name": "@carton/cli-mcp",
  "version": "0.1.0",
  "description": "The cb commands and MCP tools for Carton (history, cut, fold, credits, restore, compare, publish, conflicts, resolve) with git aliases.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "carton": "./dist/bin.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test --test-concurrency=2 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@carton/core": "0.1.0",
    "@carton/local": "0.1.0",
    "@carton/cardboard": "0.1.0",
    "@carton/store-sqlite": "0.1.0"
  },
  "bin": {
    "carton": "./src/bin.ts"
  }
}
