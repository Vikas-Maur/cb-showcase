{
  "name": "@carton/cardboard",
  "version": "0.1.0",
  "description": "HostAdapter for Cardboard 1.4.0: its schema (time group, sequences, blobRefs), the fm∘sv GUI projection, host <-> engine conversion, and the hard and soft validators.",
