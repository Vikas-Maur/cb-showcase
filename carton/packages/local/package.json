{
  "name": "@carton/local",
  "version": "0.1.0",
  "description": "Carton on one machine: carton.db lifecycle, the engine thread, the sync lease and headless helper, the materializer (displace, then install), per-agent view files and the status sidecar, .cbproj export and import.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks.ts",
    "./hook-send": "./src/hook-send.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./hooks": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "./hook-send": {
        "types": "./dist/hook-send.d.ts",
        "default": "./dist/hook-send.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --test --test-concurrency=2 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@carton/core": "workspace:*",
    "@carton/store-sqlite": "workspace:*",
    "@carton/cardboard": "workspace:*"
  },
  "devDependencies": {
    "@carton/store-memory": "workspace:*",
    "@carton/server": "workspace:*",
    "@carton/server-node": "workspace:*",
    "@carton/blob-memory": "workspace:*"
  }
}
