    "@carton/media": "0.1.0",
    "@carton/react": "0.1.0",
    "@carton/server": "0.1.0",
    "@carton/server-node": "0.1.0",
    "@carton/store-idb": "0.1.0",
    "@carton/store-memory": "0.1.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
