          "stdoutTo": "{results}/sqlite-recheck-run.log"
        }
      ],
      "reports": [
        {
          "file": "raw-sqlite-recheck.jsonl",
          "groupBy": [
            "id"
          ],
          "ignore": [
            "round",
            "loadBefore",
            "loadAfter",
            "otherCoresBefore",
            "uptime",
            "gateWaitS",
            "waitedS",
            "at",
            "node",
            "head",
            "keyframeSeq"
          ],
          "expect": {
            "cells": 6,
            "runsPerCell": 7
          }
        }
      ]
    },
    {
      "id": "stores-sqlite-ab",
      "agent": "stores",
      "claim": "verifier's A/B for S3c (commit p50 0.035 → 0.110 ms between two runs on different CPUs): in one job, A = store-sqlite before the fixes (f362256) with its harness, B = the same code with the new harness (yields between commits), C = the fixed code (snapshot) with the new harness; open and commit cells, 7 rounds, side order rotated",
      "timeout": 75,
      "steps": [
