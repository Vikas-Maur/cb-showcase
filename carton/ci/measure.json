          "cwd": "packages/store-sqlite",
          "run": [
            "{node}",
            "bench/compress.ts"
          ],
          "stdoutTo": "{results}/compress.jsonl"
        },
        {
          "label": "Carton on carton.db, three processes committing back to back, TIGHT=1, 20 runs (counts runs that fail with core's 'store changed under this write'; any other failure fails the measurement)",
          "cwd": "packages/store-sqlite",
          "env": {
            "TIGHT": "1"
          },
          "repeat": 20,
          "run": [
            "{node}",
            "--test",
            "--test-name-pattern=three processes committing",
            "test/import.test.ts"
          ],
          "stdoutTo": "{results}/tight.log",
          "failPattern": "Carton: the store changed under this write"
        },
        {
          "label": "P3/P3b under Node (test/xproc.test.ts)",
          "cwd": "packages/store-sqlite",
          "run": [
            "{node}",
            "--test",
            "--test-reporter=tap",
            "test/xproc.test.ts"
          ],
          "stdoutTo": "{results}/xproc-node.tap"
        },
        {
          "label": "P3/P3b under Electron 43.7.0's Node (test/xproc.test.ts)",
          "cwd": "packages/store-sqlite",
          "env": {
            "ELECTRON_RUN_AS_NODE": "1"
          },
          "run": [
            "{electron}",
            "--test",
            "--test-reporter=tap",
            "test/xproc.test.ts"
          ],
          "stdoutTo": "{results}/xproc-electron.tap"
        }
      ],
      "reports": [
        {
          "file": "idb-values.json",
          "kind": "json",
          "expect": {
            "rows": 1
          }
        },
        {
          "file": "compress.jsonl",
          "groupBy": [
            "level"
          ],
          "ignore": [
            "node",
            "items"
