          "label": "check out f362256 twice (A, and B with the new bench/cell.ts), npm ci in each",
          "run": [
            "bash",
            "-c",
            "set -e; cd ..; git fetch --no-tags --depth=1 origin f3622561f1ba4e9f164a0350aaca49a8d694a947; git worktree add --detach {tmp}/ab-old f3622561f1ba4e9f164a0350aaca49a8d694a947; git worktree add --detach {tmp}/ab-oldharness f3622561f1ba4e9f164a0350aaca49a8d694a947; cp carton/packages/store-sqlite/bench/cell.ts {tmp}/ab-oldharness/carton/packages/store-sqlite/bench/cell.ts; (cd {tmp}/ab-old/carton && npm ci --no-audit --no-fund); (cd {tmp}/ab-oldharness/carton && npm ci --no-audit --no-fund)"
          ]
        },
        {
          "label": "ci/xcheck/ab-sqlite.mjs: bench/run.ts for A, B, C, one round each per turn, order rotated, 7 rounds",
          "env": {
            "KF_ITEMS": "1000",
            "GFV_LOCK": "{tmp}/cpu.lock",
            "LOAD_MAX": "1.5",
            "OTHER_MAX": "0.5"
          },
          "run": [
            "{node}",
            "ci/xcheck/ab-sqlite.mjs",
